# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules

# next.js
/frontend/.next/
/frontend/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never enter the repo
.env*
backend/.env
# ...but the TEMPLATE must, or nobody deploying knows which keys exist.
# The negation has to come after the pattern that excluded it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts

# Python venv / build artefacts
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/

# SQLite database (local data, never commit)
# -shm/-wal are the WAL sidecars; they churn on every pipeline run
*.db
*.db-shm
*.db-wal

# sentence-transformers model cache (~87MB) — matched at any depth,
# the cache actually lands in backend/backend/.cache/
.cache/

# Pipeline run lock (runtime only). The lock is per store, so the real name is
# .pipeline-<hash>.lock — the two patterns below never matched it, and one got
# committed.
.pipeline-*.lock
*.pipeline.lock
.pipeline.lock

# Queued session checkpoints — raw conversation transcripts awaiting
# distillation. Runtime state, and the most sensitive thing on disk after .env.
backend/data/checkpoints/
