# Brahmastra configuration.
#
# Copy to backend/.env for local work, or supply the same keys as environment
# variables to your host. Never commit the filled-in version: .gitignore
# already excludes .env*, and backend/.dockerignore keeps it out of images.

# ---------------------------------------------------------------------------
# Storage — which graph store EVERY process uses
# ---------------------------------------------------------------------------
# Read by brahmastra/stores/__init__.py. It must live in a file rather than a
# shell, because the processes that write notes are not the process that runs
# the pipeline: the MCP server, uvicorn, the CLI and the session hooks all
# start independently. When they disagreed, an MCP-added note landed in SQLite
# and a pipeline run against Neo4j never saw it.
GRAPH_BACKEND=sqlite

# SQLite. In a container this MUST point inside a mounted volume, or the
# database is written to the image layer and discarded on the next deploy.
BRAHMASTRA_DB=/data/concept_graph.db

# Queued session captures awaiting distillation. Same rule: on a volume.
BRAHMASTRA_CHECKPOINT_DIR=/data/checkpoints

# Which graph you are working in. Uniqueness is per workspace.
BRAHMASTRA_WORKSPACE=default

# ---------------------------------------------------------------------------
# The system of record — where NOTES live
# ---------------------------------------------------------------------------
# Unset means "wherever GRAPH_BACKEND puts them", which is the original
# single-store arrangement and stays fully supported.
#
# Set it to `postgres` to separate the two. Notes and workspaces cannot be
# recomputed; triples, clusters and the cached graph are a function of the
# notes and the pipeline regenerates all of them. Keeping both in one backend
# meant choosing an engine was also a decision about irreplaceable data.
#
# The deployed arrangement is NOTE_BACKEND=postgres with GRAPH_BACKEND=neo4j.
#
# REQUIRES pgvector ON THE SERVER. It is what keeps hybrid search (BM25 fused
# with vector similarity) alive once notes leave Neo4j, and a stock PostgreSQL
# build does not ship it — the Windows installer offers only pg_trgm. Use the
# pgvector/pgvector image; docker compose's `postgres` profile does. Without
# it the store still holds notes but reports itself lexical-only, and the
# composite refuses it rather than downgrading search where nobody would see.
NOTE_BACKEND=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brahmastra
POSTGRES_PASSWORD=brahmastra
POSTGRES_DB=brahmastra
# Or supply the whole thing at once (what most hosts hand you):
# POSTGRES_DSN=postgresql://user:pass@host:5432/dbname

# Accepts a lexical-only note store, losing semantic search. Off by default:
# the failure it guards is invisible — every query still succeeds, and quietly
# returns worse results.
# ALLOW_SEARCH_DOWNGRADE=0

# ---------------------------------------------------------------------------
# Neo4j — required only when GRAPH_BACKEND=neo4j.
# URI must be bare neo4j://, not neo4j+s://: the +s schemes lock TLS config and
# forbid supplying the explicit certifi context the driver needs here.
# On Aura the username is the instance id, not "neo4j".
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# groq | ollama | anthropic. Unset = automatic, cloud first, so the same code
# deploys unchanged. An explicit choice only wins if it is actually reachable.
LLM_PROVIDER=groq

# Extraction sends response_format=json_object, so the model MUST support it.
# Groq retires hosted models, so the default in llm.py will go stale: list the
# current ones with Groq(...).models.list().
GROQ_API_KEY=
GROQ_MODEL=

ANTHROPIC_API_KEY=

# Local models. From inside a container use host.docker.internal, not
# localhost — localhost is the container itself.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# Pin a stronger model for session checkpoint distillation. Leaving this unset
# prefers a local model, so checkpointing never competes with extraction for a
# cloud daily quota.
CHECKPOINT_PROVIDER=

# ---------------------------------------------------------------------------
# Notion — entirely optional
# ---------------------------------------------------------------------------
# Without these, sync reports skipped and nothing else changes. A workspace can
# also carry its own notion_database_id, which wins over this global one.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Comma-separated allowlist. "*" is right for local development and wrong for a
# public deployment: combined with credentials it lets any site call the API.
CORS_ORIGINS=*

# uvicorn workers. Keep at 1 with GRAPH_BACKEND=sqlite — one file, and
# concurrent writers produce "database is locked". Raise only on Neo4j.
WEB_CONCURRENCY=1

PORT=8001

# ---------------------------------------------------------------------------
# Authentication — see brahmastra/auth.py
# ---------------------------------------------------------------------------
# FAILS CLOSED. With neither of these set, every route except the health probes
# returns 503, so a deployment that forgets to configure auth breaks loudly
# instead of publishing the graph to the internet quietly.
#
# Deployment: set a long random key here and do NOT set ALLOW_ANONYMOUS.
BRAHMASTRA_API_KEY=

# Local development only. Delete this line on any host that is reachable.
BRAHMASTRA_ALLOW_ANONYMOUS=1

# Serve the ten MCP tools over HTTP at /mcp, behind the same authentication as
# the REST API. Leave unset for a local stdio MCP server, which needs none of
# this — point that at a shared Neo4j instead and every device sees one graph.
MCP_HTTP=

# ---------------------------------------------------------------------------
# Resources
# ---------------------------------------------------------------------------
# Loading torch + all-MiniLM-L6-v2 costs ~461 MB RSS, measured, so a 512 MB
# instance is killed at startup. Set to 0 to fall back to exact matching plus
# Jaro-Winkler: measured cost on the live graph is 417 entity clusters with
# embeddings versus 475 without, so about 58 merges are lost.
EMBEDDINGS_ENABLED=1

# How often the optional scheduler container runs the pipeline, in seconds.
POLL_INTERVAL=900
