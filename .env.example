# Brahmastra configuration.
#
# Copy to backend/.env for local work, or supply the same keys as environment
# variables to your host. Never commit the filled-in version: .gitignore
# already excludes .env*, and backend/.dockerignore keeps it out of images.

# ---------------------------------------------------------------------------
# Storage — which graph store EVERY process uses
# ---------------------------------------------------------------------------
# Read by brahmastra/stores/__init__.py. It must live in a file rather than a
# shell, because the processes that write notes are not the process that runs
# the pipeline: the MCP server, uvicorn, the CLI and the session hooks all
# start independently. When they disagreed, an MCP-added note landed in SQLite
# and a pipeline run against Neo4j never saw it.
GRAPH_BACKEND=sqlite

# SQLite. In a container this MUST point inside a mounted volume, or the
# database is written to the image layer and discarded on the next deploy.
BRAHMASTRA_DB=/data/concept_graph.db

# Queued session captures awaiting distillation. Same rule: on a volume.
BRAHMASTRA_CHECKPOINT_DIR=/data/checkpoints

# Which graph you are working in. Uniqueness is per workspace.
BRAHMASTRA_WORKSPACE=default

# Neo4j — required only when GRAPH_BACKEND=neo4j.
# URI must be bare neo4j://, not neo4j+s://: the +s schemes lock TLS config and
# forbid supplying the explicit certifi context the driver needs here.
# On Aura the username is the instance id, not "neo4j".
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# groq | ollama | anthropic. Unset = automatic, cloud first, so the same code
# deploys unchanged. An explicit choice only wins if it is actually reachable.
LLM_PROVIDER=groq

# Extraction sends response_format=json_object, so the model MUST support it.
# Groq retires hosted models, so the default in llm.py will go stale: list the
# current ones with Groq(...).models.list().
GROQ_API_KEY=
GROQ_MODEL=

ANTHROPIC_API_KEY=

# Local models. From inside a container use host.docker.internal, not
# localhost — localhost is the container itself.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# Pin a stronger model for session checkpoint distillation. Leaving this unset
# prefers a local model, so checkpointing never competes with extraction for a
# cloud daily quota.
CHECKPOINT_PROVIDER=

# ---------------------------------------------------------------------------
# Notion — entirely optional
# ---------------------------------------------------------------------------
# Without these, sync reports skipped and nothing else changes. A workspace can
# also carry its own notion_database_id, which wins over this global one.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Comma-separated allowlist. "*" is right for local development and wrong for a
# public deployment: combined with credentials it lets any site call the API.
CORS_ORIGINS=*

# uvicorn workers. Keep at 1 with GRAPH_BACKEND=sqlite — one file, and
# concurrent writers produce "database is locked". Raise only on Neo4j.
WEB_CONCURRENCY=1

PORT=8001
